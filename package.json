{
  "name": "av8-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "web": "pnpm --filter @av8/web dev",
    "web:build": "pnpm --filter @av8/web build",
    "ios": "pnpm --filter @av8/ios start",
    "ios:doctor": "pnpm --filter @av8/ios exec expo doctor"
  },
  "pnpm": {
    "workspaces": ["apps/*", "packages/*"],
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
